page {
  background: #0f0f1a;
  color: #e8e8f0;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #e8b86d;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8a9a;
  margin-bottom: 40rpx;
}

.card {
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.3);
}

.btn {
  background: linear-gradient(135deg, #e8b86d, #c08552);
  color: #1a1a2e;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-weight: 600;
}
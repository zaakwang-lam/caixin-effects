.empty { text-align: center; padding: 120rpx 0; color: #666; }
.tip { font-size: 24rpx; margin-top: 16rpx; }
.item {
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-name { font-size: 32rpx; font-weight: 600; }
.item-cat { font-size: 22rpx; color: #e8b86d; }
.clear {
  text-align: center;
  color: #f66;
  margin-top: 40rpx;
  padding: 20rpx;
}
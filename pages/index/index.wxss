.search-bar {
  background: #1a1a2e;
  border-radius: 50rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
  border: 1rpx solid #2a2a3e;
}
.search-icon { margin-right: 16rpx; }
.search-placeholder { color: #8a8a9a; font-size: 28rpx; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 48rpx;
}
.cat-card {
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  color: white;
  min-height: 180rpx;
}
.cat-name { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.cat-desc { font-size: 22rpx; opacity: 0.85; margin-bottom: 16rpx; }
.cat-count { font-size: 24rpx; font-weight: 600; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #e8b86d;
}
.recommend .rec-name { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.rec-alias { font-size: 22rpx; color: #8a8a9a; margin-bottom: 16rpx; }
.rec-exp { font-size: 26rpx; line-height: 1.6; margin-bottom: 20rpx; }
.tag {
  display: inline-block;
  background: #2a3a2a;
  color: #7dffb3;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}